<resources>

	<!-- Base application theme. -->
	<style name="AppTheme" parent="Theme.MaterialComponents.Light.DarkActionBar">
		<!-- Customize your theme here. -->
		<item name="colorPrimary">@color/colorPrimary</item>
		<item name="colorPrimaryDark">@color/colorPrimaryDark</item>
		<item name="colorAccent">@color/colorAccent</item>
	</style>

	<style name="TextDetail" parent="TextAppearance.AppCompat.Medium">

	</style>

	<style name="details_label_style" parent="AppTheme">
		<item name="android:textSize">@dimen/dimen_12sp</item>
		<item name="android:textColor">@color/black_light</item>
		<item name="fontFamily">@font/poppins</item>
	</style>

	<style name="details_value_style" parent="AppTheme">
		<item name="android:textSize">@dimen/dimen_16sp</item>
		<item name="android:textColor">@color/black</item>
		<item name="fontFamily">@font/poppins</item>
		<item name="android:gravity">center_vertical</item>
		<item name="android:background">@drawable/details_value_bg</item>
		<item name="android:elevation">@dimen/dimen_1dp</item>
	</style>

	<style name="ErrorTextAppearance" parent="TextAppearance.AppCompat">
		<item name="android:textColor">@android:color/holo_red_light</item>
		<item name="android:textSize">14sp</item>
	</style>

	<style name="HelperTextAppearance" parent="TextAppearance.AppCompat">
		<item name="android:textColor">@android:color/black</item>
		<item name="android:textSize">14sp</item>
	</style>

	<style name="HintTextAppearance" parent="TextAppearance.AppCompat">
		<item name="android:textColor">@android:color/black</item>
		<item name="android:textSize">10sp</item>
	</style>

	<style name="EditTextThemeOverlay" parent="ThemeOverlay.AppCompat">
		<item name="colorAccent">@color/light_sky_blue</item>
	</style>

	<style name="EditTextThemeOverlayLoginPage" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
		<item name="colorAccent">@color/light_sky_blue</item>
		<item name="passwordToggleTint">@color/colorPrimary</item>
		<item name="boxStrokeColor">@color/black_light</item>
		<item name="boxBackgroundColor">@color/light_sky_blue</item>
		<item name="boxCornerRadiusBottomEnd">@dimen/dimen_10dp</item>
		<item name="boxCornerRadiusBottomStart">@dimen/dimen_10dp</item>
		<item name="boxCornerRadiusTopEnd">@dimen/dimen_10dp</item>
		<item name="boxCornerRadiusTopStart">@dimen/dimen_10dp</item>
	</style>


</resources>
